# Copy to .env for local use. On Replit, add these in Tools > Secrets instead.
# Leave ANTHROPIC_API_KEY empty to run the free demo mode (no AI calls).
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# Max AI requests per visitor IP in 15 minutes (protects your API budget)
RATE_LIMIT=40
